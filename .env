POSTGRES_PORT=5432
POSTGRES_DB=synthenexa
POSTGRES_USER=synthenexa
POSTGRES_PASSWORD=synthenexa

# Storage Backend Selection
# -------------------------
# Controls where pipeline artifacts are persisted.
#   file     — (default) writes JSON/JSONL files under experiments/artifacts/
#   postgres — writes to the PostgreSQL database configured above
#
# Can also be overridden at runtime with: --storage file|postgres
STORAGE_BACKEND=file
